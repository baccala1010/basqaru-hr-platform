<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-create-payroll-calculations" author="hr-platform">
        <createTable tableName="payroll_calculations" schemaName="employee_schema">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="working_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="worked_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="sick_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="unpaid_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="vacation_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="business_trip_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="weekend_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="holiday_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="absent_days" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_salary" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="monthly_bonus" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="gross_salary" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="opv_amount" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="osms_amount" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="iit_amount" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="net_salary" type="DECIMAL(14,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="employee_schema"
                baseTableName="payroll_calculations"
                baseColumnNames="employee_id"
                referencedTableSchemaName="employee_schema"
                referencedTableName="employees"
                referencedColumnNames="id"
                constraintName="fk_payroll_calculations_employee"/>

        <createIndex tableName="payroll_calculations" schemaName="employee_schema" indexName="idx_payroll_calculations_employee_created_at">
            <column name="employee_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

