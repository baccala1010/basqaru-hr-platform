<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-certificate-requests" author="hr-platform">
        <createTable tableName="certificate_requests" schemaName="employee_schema">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="certificate_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="generated_document_id" type="UUID"/>
            <column name="reject_reason" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableSchemaName="employee_schema" baseTableName="certificate_requests" baseColumnNames="employee_id"
                referencedTableSchemaName="employee_schema" referencedTableName="employees" referencedColumnNames="id"
                constraintName="fk_certificate_requests_employee"/>

        <createIndex tableName="certificate_requests" schemaName="employee_schema" indexName="idx_cert_requests_employee_id">
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

