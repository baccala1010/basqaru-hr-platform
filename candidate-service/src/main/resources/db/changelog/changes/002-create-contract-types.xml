<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-contract-types" author="hr-platform">
        <createTable tableName="contract_types">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_contract_types_name"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="Основной трудовой договор"/></insert>
        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="Договор на стажировку"/></insert>
        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="Дополнительное соглашение"/></insert>
        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="Договор на испытательный срок"/></insert>
        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="ГПХ"/></insert>
        <insert tableName="contract_types"><column name="id" valueComputed="gen_random_uuid()"/><column name="name" value="Договор о полной материальной ответственности"/></insert>
    </changeSet>

</databaseChangeLog>

