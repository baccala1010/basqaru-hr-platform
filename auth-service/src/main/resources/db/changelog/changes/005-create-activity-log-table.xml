<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-create-activity-log-table" author="hr-platform">
        <createTable tableName="activity_log">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="actor_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="actor_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="actor_role" type="VARCHAR(30)"/>
            <column name="action" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(100)"/>
            <column name="entity_id" type="VARCHAR(100)"/>
            <column name="details" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="activity_log" indexName="idx_activity_log_actor_id">
            <column name="actor_id"/>
        </createIndex>
        <createIndex tableName="activity_log" indexName="idx_activity_log_action">
            <column name="action"/>
        </createIndex>
        <createIndex tableName="activity_log" indexName="idx_activity_log_entity_type">
            <column name="entity_type"/>
        </createIndex>
        <createIndex tableName="activity_log" indexName="idx_activity_log_created_at">
            <column name="created_at"/>
        </createIndex>
        <createIndex tableName="activity_log" indexName="idx_activity_log_action_created">
            <column name="action"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
