<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-make-application-id-nullable-add-uploaded-by" author="hr-platform">
        <dropNotNullConstraint tableName="documents" schemaName="document_schema" columnName="application_id"/>
        <addColumn tableName="documents" schemaName="document_schema">
            <column name="uploaded_by" type="UUID"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
